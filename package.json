{
  "name": "hireme-co",
  "version": "3.0.0",
  "private": true,
  "description": "HireMe.co evidence-based AI talent and industry platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "build": "tailwindcss -i public/input.css -o public/utilities.css --minify",
    "check": "node scripts/check.js",
    "supabase:check": "node scripts/supabase-check.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
