PORT=3000
DATABASE_PATH=./data/hireme.sqlite
UPLOAD_DIR=./data/uploads
SEED_DEMO=true
DEMO_PASSWORD=Demo123!

# Optional PDF parser. If PyMuPDF is not installed, the server uses its safe fallback.
# Never expose provider keys in browser code.
OPENAI_API_KEY=
SUPABASE_URL=
# Use the Publishable/anon key for SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# Use the Secret/service_role key for server-only SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REDIRECT_URL=http://localhost:3000/#reset-password

# When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, app records are
# mirrored to Supabase app_records and hydrated into the local SQLite cache.
# Keep the service role key server-only; never put it in browser code.
